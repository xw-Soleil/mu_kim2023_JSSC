# Local EDA/tool state. Keep these paths in place; do not version them.
/.cadence/
/PreFrameCheck/
/alib-*/
/flow/local/env_local.sh

# Generated implementation databases, reports, and deliverables.
/flow/local_runs/
/flow/work/
/flow/results/
/flow/reports/
/flow/innovus/*.tgz

# Local root-session archive. Only its policy README and the tiny
# plain-integer regression baseline grids are versioned; logs and manifests
# with machine paths stay local.
/local_artifacts/*
!/local_artifacts/README.md
!/local_artifacts/vcs/
/local_artifacts/vcs/*
!/local_artifacts/vcs/pre-sync-baseline/
/local_artifacts/vcs/pre-sync-baseline/*
!/local_artifacts/vcs/pre-sync-baseline/2026-08-06/
/local_artifacts/vcs/pre-sync-baseline/2026-08-06/*
!/local_artifacts/vcs/pre-sync-baseline/2026-08-06/u_*.txt
!/local_artifacts/vcs/post-sync-baseline/
/local_artifacts/vcs/post-sync-baseline/*
!/local_artifacts/vcs/post-sync-baseline/2026-08-06/
/local_artifacts/vcs/post-sync-baseline/2026-08-06/*
!/local_artifacts/vcs/post-sync-baseline/2026-08-06/u_*.txt

# Simulation build products (compiled binaries, logs, dumps).
/sim/build/
*.fsdb

# One-off pre-edit backup kept on disk only.
/flow/calibre/block_signoff_config.sh.bak

# Prevent Synopsys/Cadence session debris from repopulating the repository root.
/check_design*.log
/check_design*.ems
/check_workspace.ems
/default-*.svf
/command.log
/icc2_command.log
/icc2_output.txt
/lm_command.log
/lm_output.txt
/crte_*.txt
/Synopsys_stack_trace_*.txt
/libManager.log
/.graph_data.txt

# Simulation, editor, MATLAB, and Python transient files.
*.vcd
*.fst
*.vvp
*.wlf
*.asv
*.swp
*~
.nfs*
__pycache__/
*.py[cod]
