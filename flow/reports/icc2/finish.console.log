# ICC2 place-and-route flow for pde_chip_top_safe on TSMC65LP RVT 6LM-T1.
# Run with: icc2_shell -f flow/icc2/pnr.tcl

proc env_or_default {name fallback} {
  if {[info exists ::env($name)] && [string trim $::env($name)] ne ""} {
    return $::env($name)
  }
  return $fallback
}

proc require_regular_file {path description} {
  if {![file exists $path] || ![file isfile $path] || ![file readable $path]} {
    error "$description is missing or unreadable: $path"
  }
}

proc require_path {path description} {
  if {![file exists $path] || ![file readable $path]} {
    error "$description is missing or unreadable: $path"
  }
}

proc require_command {name} {
  if {[llength [info commands $name]] == 0} {
    error "Required ICC2 command is unavailable in this release: $name"
  }
}

proc require_one_lib_cell {master} {
  set matches [get_lib_cells -quiet "*/$master"]
  if {[sizeof_collection $matches] == 0} {
    error "Required RVT library master is absent from the NDM: $master"
  }
  return $matches
}

proc connect_named_pg_pins {} {
  set vdd_pins [get_pins -hierarchical -physical_context -quiet */VDD]
  set vss_pins [get_pins -hierarchical -physical_context -quiet */VSS]
  if {[sizeof_collection $vdd_pins] == 0} {
    error "No physical VDD pins were found; verify the RVT NDM and netlist link"
  }
  if {[sizeof_collection $vss_pins] == 0} {
    error "No physical VSS pins were found; verify the RVT NDM and netlist link"
  }
  connect_pg_net -net VDD $vdd_pins
  connect_pg_net -net VSS $vss_pins
}

set SCRIPT_DIR [file dirname [file normalize [info script]]]
set REPO_ROOT [file normalize [env_or_default PDE_REPO_ROOT \
  [file join $SCRIPT_DIR .. ..]]]
set TOP [env_or_default PDE_TOP pde_chip_top_safe]

set RVT_ROOT "/ssd0/PDKs/TSMC65nm/STDCELL/std/STD_Cell/tcbn65lp_200b"
set RVT_MW [file join $RVT_ROOT Back_End milkyway tcbn65lp_200a]

set NETLIST [file normalize [env_or_default PDE_DC_NETLIST \
  [file join $REPO_ROOT flow results dc ${TOP}.v]]]
set SDC [file normalize [env_or_default PDE_DC_SDC \
  [file join $REPO_ROOT flow results dc ${TOP}.sdc]]]
set REF_NDM [file normalize [env_or_default PDE_REF_NDM \
  [file join $REPO_ROOT flow work icc2 ref tcbn65lp_6lmT1.ndm]]]
set TLU_WORST [env_or_default PDE_TLUPLUS_MAX \
  [file join $RVT_MW techfiles tluplus cln65lp_1p06m+alrdl_rcworst_top1.tluplus]]
set TLU_BEST [env_or_default PDE_TLUPLUS_MIN \
  [file join $RVT_MW techfiles tluplus cln65lp_1p06m+alrdl_rcbest_top1.tluplus]]
set TLU_MAP [env_or_default PDE_TLUPLUS_MAP \
  [file join $RVT_MW techfiles tluplus star.map_6M]]
set GDS_MAP [env_or_default PDE_GDS_MAP \
  [file join $RVT_MW gdsout_3X1Z.map]]
set GDS_MAP_FORMAT [env_or_default PDE_GDS_MAP_FORMAT icc_default]

set WORK_DIR [file join $REPO_ROOT flow work icc2]
set RESULT_DIR [file join $REPO_ROOT flow results icc2]
set REPORT_DIR [file join $REPO_ROOT flow reports icc2]
set DESIGN_LIB [file normalize [env_or_default PDE_ICC2_DESIGN_LIB \
  [file join $WORK_DIR ${TOP}.dlib]]]

foreach item [list \
  [list $NETLIST "DC gate-level netlist"] \
  [list $SDC "DC SDC"] \
  [list $TLU_WORST "RC-worst TLU+"] \
  [list $TLU_BEST "RC-best TLU+"] \
  [list $TLU_MAP "6M TLU+ layer map"] \
  [list $GDS_MAP "RVT stream-out map"]] {
  require_regular_file [lindex $item 0] [lindex $item 1]
}
require_path $REF_NDM "RVT reference NDM"

file mkdir $WORK_DIR
file mkdir $RESULT_DIR
file mkdir $REPORT_DIR
if {[file exists $DESIGN_LIB]} {
  error "Refusing to overwrite existing ICC2 design library: $DESIGN_LIB"
}

puts "PDE_ICC2: top=$TOP"
puts "PDE_ICC2: netlist=$NETLIST"
puts "PDE_ICC2: sdc=$SDC"
puts "PDE_ICC2: ref_ndm=$REF_NDM"

create_lib -use_technology_lib $REF_NDM -ref_libs [list $REF_NDM] $DESIGN_LIB
read_verilog -top $TOP [list $NETLIST]
current_block $TOP
link_block

redirect -file [file join $REPORT_DIR link_check.rpt] {
  check_design -checks {netlist unbound}
}

# Build one functional mode and explicit WC/BC timing/RC corners.  The NDM was
# created with matching uppercase process labels in create_ndm.tcl.
remove_scenarios -all
remove_modes -all
remove_corners -all
create_mode FUNC
create_corner WC
create_corner BC
create_scenario -mode FUNC -corner WC -name FUNC_WC
create_scenario -mode FUNC -corner BC -name FUNC_BC

current_mode FUNC
read_sdc $SDC
set_process_label WC -corners [get_corners WC]
set_process_label BC -corners [get_corners BC]

read_parasitic_tech -tlup $TLU_WORST -layermap $TLU_MAP -name RC_WORST
read_parasitic_tech -tlup $TLU_BEST -layermap $TLU_MAP -name RC_BEST
set_parasitic_parameters -corners [get_corners WC] \
  -early_spec RC_WORST -late_spec RC_WORST
set_parasitic_parameters -corners [get_corners BC] \
  -early_spec RC_BEST -late_spec RC_BEST

set_scenario_status [get_scenarios FUNC_WC] \
  -active true -setup true -hold false \
  -max_transition true -max_capacitance true \
  -leakage_power true -dynamic_power true
set_scenario_status [get_scenarios FUNC_BC] \
  -active true -setup false -hold true \
  -max_transition true -max_capacitance true \
  -leakage_power false -dynamic_power false
current_scenario FUNC_WC

# Constrain signal routing to the six-layer stack.  M5 is horizontal and M6
# vertical in the selected foundry TF/LEF.
foreach layer_name {M1 M3 M4 M5 M6} {
  if {[sizeof_collection [get_layers -quiet $layer_name]] == 0} {
    error "Required routing layer is missing from 6LM-T1 technology: $layer_name"
  }
}
set_ignored_layers -min_routing_layer M1 -max_routing_layer M6

# Square, 55%-utilized core.  The 10 um core-to-die margin contains the two-net
# ring with the conservative baseline widths below.
initialize_floorplan -control_type core -shape R -side_ratio {1.0 1.0} \
  -core_utilization 0.55 -core_offset 10.0
set_block_pin_constraints -self -allowed_layers [get_layers {M3 M4}] \
  -corner_keepout_num_tracks 2 -pin_spacing 0.4 -allow_feedthroughs false
place_pins -self

# This design has no pad ring or qualified supply-pin locations.  Create named
# PG nets and connect every RVT leaf PG pin; do not invent pad cells or bumps.
if {[sizeof_collection [get_nets -quiet VDD]] == 0} {
  create_net -power VDD
} else {
  set_attribute [get_nets VDD] net_type power
}
if {[sizeof_collection [get_nets -quiet VSS]] == 0} {
  create_net -ground VSS
} else {
  set_attribute [get_nets VSS] net_type ground
}
connect_named_pg_pins

# Guard the ICC2 pattern API and the concrete layer/cell assumptions before PG
# compilation.  Widths/spacing are an implementation baseline, not an IR/EM-
# signed-off grid; update them only from a qualified power-budget analysis.
foreach pg_command {create_pg_ring_pattern create_pg_std_cell_conn_pattern set_pg_strategy compile_pg} {
  require_command $pg_command
}
if {[catch {
  create_pg_ring_pattern PDE_CORE_RING \
    -horizontal_layer M5 -vertical_layer M6 \
    -horizontal_width 1.6 -vertical_width 1.6 \
    -horizontal_spacing 0.8 -vertical_spacing 0.8
  set_pg_strategy PDE_CORE_RING_STRATEGY -core \
    -pattern {{name: PDE_CORE_RING} {nets: {VDD VSS}} {offset: {2.0 2.0}}}
  compile_pg -strategies {PDE_CORE_RING_STRATEGY}

  # Standard-cell rails must follow the M1 power pins; M5/M6 form the ring.
  create_pg_std_cell_conn_pattern PDE_STDCELL_RAILS \
    -layers {M1} -mark_as_follow_pin true
  set_pg_strategy PDE_STDCELL_RAIL_STRATEGY -core \
    -pattern {{name: PDE_STDCELL_RAILS} {nets: {VDD VSS}}} \
    -extension {{stop: innermost_ring}}
  compile_pg -strategies {PDE_STDCELL_RAIL_STRATEGY}
} pg_error]} {
  error "PG pattern compilation failed; verify the foundry via rules and qualified grid dimensions: $pg_error"
}
connect_named_pg_pins
save_block

# Do not invent tap/endcap masters: the installed library contains variants,
# but no project/foundry-approved tap/endcap selection or spacing rule was
# supplied.  This omission is explicit and must be resolved before tapeout.
puts "PDE_ICC2_WARNING: tap/endcap insertion intentionally omitted pending approved masters/rules"

set ANTENNA_CELLS [require_one_lib_cell ANTENNA]
set FILLER_MASTERS {FILL64 FILL32 FILL16 FILL8 FILL4 FILL2 FILL1}
set filler_patterns {}
foreach filler_master $FILLER_MASTERS {
  require_one_lib_cell $filler_master
  lappend filler_patterns "*/$filler_master"
}
set FILLER_CELLS [get_lib_cells -quiet $filler_patterns]
set_lib_cell_purpose -include optimization $ANTENNA_CELLS
set_lib_cell_purpose -include none $FILLER_CELLS

