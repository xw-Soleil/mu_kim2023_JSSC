}
set FILLER_CELLS [get_lib_cells -quiet $filler_patterns]
set_lib_cell_purpose -include optimization $ANTENNA_CELLS
set_lib_cell_purpose -include none $FILLER_CELLS

# Enable the documented O-2018.06-SP1 antenna flow and the real RVT diode.
set_app_options -name route.detail.antenna -value true
set_app_options -name route.detail.diode_libcell_names -value {ANTENNA}
set_app_options -name route.detail.insert_diodes_during_routing -value true
set_app_options -name route.detail.antenna_fixing_preference -value use_diodes
set_app_options -name route.detail.diode_insertion_mode -value new

