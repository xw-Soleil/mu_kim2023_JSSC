PDE_COMPAT: 1 处 -- select the rebuilt NDM standard-cell site 'core'
puts "PDE_COMPAT: 共替换 $total 处，补丁后脚本写到 $dst"
PDE_COMPAT: 共替换 2 处，补丁后脚本写到 /home/soleil/code/DigitalIC/PDE/pdeMujunjie/flow/local_runs/full_clean_20260804/icc2/work/icc2/pnr.patched.tcl
set fh [open $dst w]
file26
puts -nonewline $fh $body
close $fh
source $dst
