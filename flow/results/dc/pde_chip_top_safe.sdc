###################################################################

# Created by write_sdc on Sat Aug  1 02:45:29 2026

###################################################################
set sdc_version 2.1

set_units -time ns -resistance kOhm -capacitance pF -voltage V -current mA
set_max_fanout 32 [current_design]
set_max_transition 0.5 [current_design]
set_load -pin_load 0.05 [get_ports cfg_ready]
set_load -pin_load 0.05 [get_ports cfg_rvalid]
set_load -pin_load 0.05 [get_ports {cfg_rdata[15]}]
set_load -pin_load 0.05 [get_ports {cfg_rdata[14]}]
set_load -pin_load 0.05 [get_ports {cfg_rdata[13]}]
set_load -pin_load 0.05 [get_ports {cfg_rdata[12]}]
set_load -pin_load 0.05 [get_ports {cfg_rdata[11]}]
set_load -pin_load 0.05 [get_ports {cfg_rdata[10]}]
set_load -pin_load 0.05 [get_ports {cfg_rdata[9]}]
set_load -pin_load 0.05 [get_ports {cfg_rdata[8]}]
set_load -pin_load 0.05 [get_ports {cfg_rdata[7]}]
set_load -pin_load 0.05 [get_ports {cfg_rdata[6]}]
set_load -pin_load 0.05 [get_ports {cfg_rdata[5]}]
set_load -pin_load 0.05 [get_ports {cfg_rdata[4]}]
set_load -pin_load 0.05 [get_ports {cfg_rdata[3]}]
set_load -pin_load 0.05 [get_ports {cfg_rdata[2]}]
set_load -pin_load 0.05 [get_ports {cfg_rdata[1]}]
set_load -pin_load 0.05 [get_ports {cfg_rdata[0]}]
set_load -pin_load 0.05 [get_ports scan_out]
set_load -pin_load 0.05 [get_ports scan_valid]
set_load -pin_load 0.05 [get_ports scan_last]
set_ideal_network [get_ports clk]
set_ideal_network [get_ports rst_n]
create_clock [get_ports clk]  -name core_clk  -period 10  -waveform {0 5}
set_clock_uncertainty 0.2  [get_clocks core_clk]
set_clock_transition -max -rise 0.1 [get_clocks core_clk]
set_clock_transition -max -fall 0.1 [get_clocks core_clk]
set_clock_transition -min -rise 0.1 [get_clocks core_clk]
set_clock_transition -min -fall 0.1 [get_clocks core_clk]
set_false_path   -from [get_ports rst_n]
set_input_delay -clock core_clk  1  [get_ports cfg_valid]
set_input_delay -clock core_clk  1  [get_ports cfg_write]
set_input_delay -clock core_clk  1  [get_ports {cfg_addr[15]}]
set_input_delay -clock core_clk  1  [get_ports {cfg_addr[14]}]
